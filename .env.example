# Copy this file to .env and fill in real values.

# Local Postgres connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/cooksnook?schema=public"

JWT_SECRET="replace-with-a-long-random-string"

# Port the Express server listens on (optional, defaults to 3001)
PORT=3001

# LLM provider settings (optional; offline fallback is used when no key exists)
LLM_API_KEY="your-api-key-here"
LLM_API_URL="https://api.openai.com/v1/responses"
LLM_MODEL="gpt-4.1-mini"
LLM_OFFLINE_MODE=false
# Temporary console diagnostics for one live suggestion call; keep false normally.
LLM_DEBUG_LOG=false
# Provider timeout in milliseconds; increase for the first local model load.
LLM_TIMEOUT_MS=45000

# Set LLM_PROVIDER=ollama to use a local Ollama server instead of OpenAI.
LLM_PROVIDER="openai"
OLLAMA_API_URL="http://localhost:11434/api/chat"
OLLAMA_MODEL="llama3.1:8b"

# Optional recipe lookup provider. The free development endpoint uses key 1.
MEALDB_ENABLED=false
MEALDB_API_URL="https://www.themealdb.com/api/json/v1/1"

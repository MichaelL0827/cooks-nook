# Local Postgres connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/cooksnook?schema=public"

JWT_SECRET="replace-with-a-long-random-string"

# Port the Express server listens on (optional, defaults to 3001)
PORT=3001

# LLM provider API key (Claude or OpenAI, whichever you choose)
LLM_API_KEY="your-api-key-here"
